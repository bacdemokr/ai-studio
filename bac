#!/usr/bin/env bash
# One entry point: Docker for users; explicit dev subcommands for host installs.
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

usage() {
  cat <<'HELP'
BaC Agent Studio

  ./bac start     Install / start / apply updated app files
  ./bac status    Check service status
  ./bac logs      Show recent errors and activity
  ./bac stop      Stop services; keep saved data
  ./bac remove    Uninstall BaC, old images and all project data (asks once)

First time? Run ./bac start, then connect your model in Settings.
Developers with a source checkout: ./bac dev --help
HELP
}
die() { echo "BaC: $*" >&2; exit 1; }
command_name=${1:-help}
case "$command_name" in
  help|-h|--help) usage; exit 0 ;;
  dev)
    shift
    [[ -f scripts/manage.py ]] || die 'Development commands require the source checkout.'
    command -v python3 >/dev/null || die 'Host development requires Python 3.9 or newer.'
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,9) else "Python 3.9+ is required.")'
    if [[ ${1:-} == preview ]]; then
      shift
      python3 scripts/build.py
      exec python3 scripts/serve.py "$@"
    fi
    exec python3 scripts/manage.py "$@"
    ;;
  start|status|logs|stop|remove) ;;
  *) usage >&2; die "Unknown command: $command_name. Old host commands now use ./bac dev COMMAND." ;;
esac
[[ $# -eq 1 ]] || die "Use ./bac $command_name without extra arguments."
if [[ $command_name == start ]]; then
  bash scripts/setup-key-filter.sh
  [[ ! -L api.cfg ]] || die 'api.cfg must be a regular file, not a symlink.'
  if [[ ! -e api.cfg ]]; then (umask 077; touch api.cfg); fi
  [[ -f api.cfg ]] || die 'api.cfg must be a regular file.'
  chmod 600 api.cfg
  if ! LC_ALL=C awk 'NF {if (NF != 1) bad=1; count++} END {exit (bad || count != 1)}' api.cfg; then
    die 'Put a valid inference API key in api.cfg, then run ./bac start again.'
  fi
fi
[[ $(uname -s) == Linux ]] || die 'Docker deployment targets Ubuntu. For the existing Mac source preview use ./bac dev preview.'
command -v docker >/dev/null || die 'Install Docker Engine and its Compose plugin, then run ./bac start again.'
docker compose version >/dev/null 2>&1 || die 'Docker Compose is missing. Install the Docker Compose plugin.'
endpoint=${DOCKER_HOST:-$(docker context inspect --format '{{(index .Endpoints "docker").Host}}')}
[[ $endpoint == unix://* ]] || die 'Use a local Docker Engine; remote Docker contexts are not supported.'
engine=$(docker info --format '{{.ServerVersion}} {{.Architecture}} {{json .SecurityOptions}}' 2>/dev/null) || die 'Docker is not reachable. Start Docker and check that this account can run docker info.'
[[ $engine != *rootless* ]] || die 'This package requires a rootful Docker Engine.'
[[ ${engine%%.*} =~ ^[0-9]+$ ]] && (( ${engine%%.*} >= 28 )) || die 'Docker Engine 28 or newer is required.'
compose_version=$(docker compose version --short)
compose_version=${compose_version#v}
IFS=. read -r compose_major compose_minor _ <<< "$compose_version"
[[ $compose_major =~ ^[0-9]+$ && $compose_minor =~ ^[0-9]+$ ]] || die 'Could not determine the Compose version.'
(( compose_major > 2 || (compose_major == 2 && compose_minor >= 24) )) || die 'Docker Compose 2.24 or newer is required.'

if [[ ! -f .env ]]; then
  [[ -f .env.example ]] || die 'The release is incomplete: keep .env beside bac and compose.yaml.'
  cp .env.example .env
fi
[[ -f compose.yaml ]] || die 'Keep bac and compose.yaml in the same folder.'
compose() { docker compose -f compose.yaml "$@"; }
trap 'code=$?; echo "BaC: $command_name failed. Run ./bac status and ./bac logs for details." >&2; exit "$code"' ERR

ensure_image() {
  # Read Docker’s resolved YAML, without executing .env or requiring Python/jq.
  local image archive checksum actual expected
  image=$(compose config | awk '$1=="studio:" {studio=1; next} studio && !found && $1=="image:" {print $2; found=1}')
  [[ -n $image ]] || die 'Could not find the studio image in compose.yaml.'
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    if [[ -f image-archive.txt ]]; then
      IFS= read -r archive < image-archive.txt
      [[ $archive =~ ^[a-zA-Z0-9._-]+\.tar(\.gz)?$ && -f $archive ]] || die 'The release image archive is missing. Copy the whole release folder to this PC.'
      [[ -f SHA256SUMS ]] || die 'The release checksum file is missing.'
      checksum=$(awk -v file="$archive" '$2==file {print}' SHA256SUMS)
      [[ -n $checksum ]] || die 'No checksum was supplied for this image archive.'
      echo 'Checking and loading the supplied image…'
      printf '%s\n' "$checksum" | sha256sum --check --status - || die 'Image checksum failed. Copy the release image again.'
      docker load -i "$archive"
    elif [[ -f Dockerfile && ! -f release.json ]]; then
      compose build
    else
      echo 'Downloading the release image…'
      compose pull studio init
    fi
  fi
  actual=$(docker image inspect --format '{{.Architecture}}' "$image")
  case "$(echo "$engine" | awk '{print $2}')" in
    aarch64|arm64) expected=arm64 ;;
    x86_64|amd64) expected=amd64 ;;
    *) die 'This release supports AMD64 and ARM64 Docker hosts.' ;;
  esac
  [[ $actual == "$expected" ]] || die "This image is $actual; use the $expected release folder for this PC."
  studio_image=$image
  if [[ $command_name == start ]]; then
    if ! docker run --rm --pull never --network none --entrypoint python3 \
      --mount "type=bind,src=$PWD,dst=/opt/bac/source,readonly" \
      "$image" /opt/bac/bootstrap.py --check; then
      if [[ -f Dockerfile && ! -f release.json ]]; then
        echo 'Runtime requirements changed. Rebuilding the dependency image…'
        compose build
        docker run --rm --pull never --network none --entrypoint python3 \
          --mount "type=bind,src=$PWD,dst=/opt/bac/source,readonly" \
          "$image" /opt/bac/bootstrap.py --check
      else
        die 'App and runtime image do not match. Install the matching complete release.'
      fi
    fi
  fi
}

resource_files() {
  helper=remove.py; lock=runtime-lock.json
  if [[ -f scripts/container_remove.py && ! -f release.json ]]; then
    helper=scripts/container_remove.py; lock=docker/runtime-lock.json
  fi
  [[ -f $helper && -f $lock ]] || die 'Resource files are missing. Copy the complete release folder and retry.'
}

case "$command_name" in
  start)
    resource_files
    ensure_image
    echo 'Checking app files before restarting services…'
    docker run --rm --pull never --network none --entrypoint python3 \
      --mount "type=bind,src=$PWD,dst=/opt/bac/source,readonly" \
      "$studio_image" /opt/bac/source/scripts/build.py --check
    echo 'Checking the inference API key in api.cfg…'
    if ! compose run --rm --no-deps -T --user 0 --entrypoint python3 \
      -v "$PWD/api.cfg:/run/bac-api.cfg:ro" studio \
      /opt/bac/source/scripts/api_key_setup.py /run/bac-api.cfg; then
      exit 1
    fi
    # Record before provisioning so failed starts and later version changes are
    # both covered by remove. This helper needs no Docker socket or network.
    docker run --rm --pull never --network none --user 0 --entrypoint python3 \
      -v /var/lib/bac-openshell:/var/lib/bac-openshell \
      --mount "type=bind,src=$PWD/$helper,dst=/resources.py,readonly" \
      --mount "type=bind,src=$PWD/$lock,dst=/runtime-lock.json,readonly" \
      "$studio_image" /resources.py --record /runtime-lock.json "$studio_image"
    mkdir -p shared
    echo 'Restarting BaC services. Active work may stop; saved data is kept.'
    compose stop studio openshell
    echo 'Starting the studio and checking readiness…'
    compose up -d --force-recreate --no-build --pull missing --wait --wait-timeout 180
    # The generated config contains the effective port even with .env overrides.
    port=$(compose config | awk '$1=="studio:" {studio=1; next} studio && !found && $1=="PORT:" {gsub(/"/,"",$2); print $2; found=1}')
    echo "Ready: http://localhost:${port:-8080}"
    echo 'Connect your model in Settings → Model. The model server stays on this PC.'
    ;;
  status) compose ps -a ;;
  logs) compose logs --tail=80 studio openshell ;;
  stop) compose stop; echo 'BaC stopped. Saved data is kept. Start again with ./bac start.' ;;
  remove)
    install_dir=$(pwd -P)
    removal_mode=release
    if [[ -f scripts/container_remove.py && ! -f release.json ]]; then
      removal_mode=source
    fi
    echo 'Remove BaC containers, agents, chats, results, shared files, backups, OpenShell state and current/previous BaC images.'
    if [[ $removal_mode == release ]]; then
      echo "Also deletes this release folder and all its files: $install_dir"
    else
      echo 'Also removes local BaC settings. Source code remains.'
    fi
    printf 'Type remove to continue: '
    if ! IFS= read -r confirmation || [[ $confirmation != remove ]]; then
      echo 'Cancelled.'; exit 0
    fi
    resource_files
    ensure_image
    image=$(compose config | awk '$1=="studio:" {studio=1; next} studio && !found && $1=="image:" {print $2; found=1}')
    if ! removal=$(docker run --rm --pull never --network none --user 0 \
      --label com.nvidia.bac.cleanup=true --entrypoint python3 \
      --mount "type=bind,src=${endpoint#unix://},dst=/var/run/docker.sock" \
      -v /var/lib/bac-openshell:/var/lib/bac-openshell \
      --mount "type=bind,src=$PWD/$helper,dst=/remove.py,readonly" \
      --mount "type=bind,src=$PWD/$lock,dst=/runtime-lock.json,readonly" \
      --mount "type=bind,src=$install_dir,dst=/installation" \
      "$image" /remove.py /runtime-lock.json /installation "$install_dir" "$removal_mode"); then
      printf '%s\n' "$removal"
      die 'Removal did not finish. Fix the reported issue and run ./bac remove again.'
    fi
    image_refs=()
    while IFS= read -r line; do
      if [[ $line != 'BAC_IMAGE '* ]]; then printf '%s\n' "$line"; continue; fi
      image_refs+=("${line#BAC_IMAGE }")
    done <<< "$removal"
    # Retry parents after deleting their derived images; never force a shared
    # image away. Stop if another pass makes no progress.
    while (( ${#image_refs[@]} )); do
      remaining=(); progress=0
      for ref in "${image_refs[@]}"; do
        if ! image_id=$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null); then continue; fi
        users=$(docker ps -aq --filter "ancestor=$image_id")
        if [[ -z $users ]] && docker image rm "$ref"; then
          progress=1
        else
          remaining+=("$ref")
        fi
      done
      if (( ${#remaining[@]} )); then image_refs=("${remaining[@]}"); else image_refs=(); fi
      (( progress )) || break
    done
    if [[ $removal_mode == release ]]; then
      cd ..
      rmdir -- "$install_dir" || die "BaC data was removed, but the release folder remains: $install_dir"
    fi
    if (( ${#image_refs[@]} )); then
      printf 'Image still in use or not removed: %s\n' "${image_refs[@]}" >&2
      die 'BaC data was removed, but image cleanup is incomplete.'
    fi
    echo 'BaC removed. Shared files and backups deleted.'
    ;;
esac
